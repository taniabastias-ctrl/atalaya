# Configuración del agente de licitaciones cuando corre en el servidor de Sermaluc (perfil "agente").
# Copie este archivo como agente.env.

# Ticket de la API de Mercado Público (api.mercadopublico.cl)
MP_TICKET=

# Mismo valor que AGENT_TOKEN en instalacion/.env
ATALAYA_TOKEN=

# Correo diario (Google Workspace de Sermaluc: contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
