# Configuración de Atalaya en el servidor de Sermaluc.
# Copie este archivo como .env (o genere uno con: node ../scripts/generar-secretos.mjs atalaya.sermaluc.cl)

# Dominio público (el DNS debe apuntar a este servidor)
DOMINIO=atalaya.sermaluc.cl

# Secreto para firmar sesiones (64 caracteres aleatorios). NO reutilizar el de Cloudflare.
SESSION_SECRET=

# Token con el que el agente publica su reporte diario (48+ caracteres aleatorios).
# Debe ser el mismo valor que ATALAYA_TOKEN en la configuración del agente.
AGENT_TOKEN=

# Correos con rol de administración (separados por coma)
ADMIN_EMAILS=tania.bastias@sermaluc.cl

# Solo se aceptan cuentas de este dominio
ALLOWED_DOMAIN=sermaluc.cl

# Ingreso con Google (opcional). Redirect URI autorizado en Google Cloud:
#   https://<DOMINIO>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Avisos por correo (opcional): al asignar una licitación y al agregar notas.
# TLS directo, puerto 465. Con Google Workspace: smtp.gmail.com y una contraseña de aplicación
# (myaccount.google.com/apppasswords) de la cuenta que envía.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Remitente (por defecto SMTP_USER; con Gmail debe ser esa cuenta o un alias suyo)
MAIL_FROM=
# Dirección pública para los enlaces de los correos (por defecto https://DOMINIO)
APP_URL=

# Registro de accesos en la consola (1 = sí)
LOG=1
