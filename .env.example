# Copia este archivo como .env y completa los valores.
PORT=8080
# Secreto para firmar sesiones (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Token del agente de licitaciones para cargar el reporte diario (mínimo 24 caracteres)
AGENT_TOKEN=
# Correos con rol de administración (pueden agregar o quitar integrantes del equipo)
ADMIN_EMAILS=
ALLOWED_DOMAIN=sermaluc.cl
# Ruta del archivo de base de datos SQLite (por defecto ./datos/atalaya.db)
# DB_PATH=/data/atalaya.db
# 1 = cargar datos de demostración si la base está vacía
DEMO=0
